ArticulatedBipedConfig: {
	DisplayName: Highwatcher

	StompRangeTiles: {
		Label: Stomp Range (Tiles)
		Tooltip: How far the shock travels to either side of the impact point.
	}

	StompDamage: {
		Label: Stomp Damage
		Tooltip: Base damage dealt by the stomp.
	}

	HeadStrikeDamage: {
		Label: Head Strike Damage
		Tooltip: Base damage dealt by the head during the downswing.
	}

	StompLongHoldChancePercent: {
		Label: Long Hold Chance (%)
		Tooltip: Chance to hold the foot longer, rolled once at the start of each stomp.
	}

	StompExtraHoldTicks: {
		Label: Extra Hold (Ticks)
		Tooltip: Ticks added to the normal raised-foot hold when the long hold is selected.
	}

	JumpReactionChancePercent: {
		Label: Jump Counter Chance (%)
		Tooltip: Chance to use a quick neck strike when the target jumps or is knocked upward.
	}

	StompHoldTicks: {
		Label: Raised Foot Hold (Ticks)
		Tooltip: How long the raised foot is held before the stomp. 60 ticks is roughly one second.
	}
}
